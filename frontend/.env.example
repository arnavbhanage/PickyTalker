DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Explicit selection: gmail for Gmail SMTP, resend for the Resend API.
EMAIL_PROVIDER=resend
# Gmail account used to send mail (not noreply@an-unowned-domain).
GMAIL_SMTP_USER=
# Google App Password, NOT your normal Gmail password; server-only.
GMAIL_SMTP_APP_PASSWORD=
# Server-only Resend API key (never NEXT_PUBLIC_*).
RESEND_API_KEY=
# Sender on your verified Resend domain, optionally Name <address>.
RESEND_FROM_EMAIL=
# AUTH_EMAIL_FROM is also accepted as a backwards-compatible sender alias.
NEXT_PUBLIC_PICKYTALKER_API_URL=
