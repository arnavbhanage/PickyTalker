# Public URL of the FastAPI backend. This is not a secret.
NEXT_PUBLIC_PICKYTALKER_API_URL=http://127.0.0.1:8000

# Public Supabase project credentials. Replace these with values from the
# project's Connect dialog. Access must still be protected with Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
